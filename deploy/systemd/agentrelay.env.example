AGENTRELAY_TOKEN_FILE=/etc/agentrelay/token
AGENTRELAY_DB_PATH=/var/lib/agentrelay/relay.db
AGENTRELAY_HOST=127.0.0.1
AGENTRELAY_PORT=8899
AGENTRELAY_MSG_TTL_HOURS=72

# Optional Telegram control bot.
# AGENTRELAY_TG_TOKEN=123456:ABC...
# AGENTRELAY_TG_CHAT=-1001234567890

# Optional Telegram bot-to-bot polling transport.
# AGENTRELAY_TELEGRAM_TRANSPORT=1

# Optional Telegram supervisor bot. Use this for a human-in-loop group where
# existing agent bots keep their own tokens/services.
# AGENTRELAY_TELEGRAM_SUPERVISOR=1
# AGENTRELAY_SUPERVISOR_TG_TOKEN=123456:ABC...
# AGENTRELAY_SUPERVISOR_TG_CHAT=-1001234567890
# AGENTRELAY_SUPERVISOR_ROOM=telegram:lab
# AGENTRELAY_SUPERVISOR_MODERATE=0
# AGENTRELAY_SUPERVISOR_COOLDOWN=30
# AGENTRELAY_SUPERVISOR_AGENT_CAP=3
